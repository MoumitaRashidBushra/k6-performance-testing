{
	"info": {
		"_postman_id": "7c1e2f2a-3b6a-4c7e-9c2a-dm0ney0e2e0001",
		"name": "DMoney - E2E Business Flow (Register -> Activate -> Deposit -> SendMoney -> Withdraw -> Payment)",
		"description": "End-to-end DMoney flow built from dmoney-transaction-api's actual controllers (verified against source, not just Swagger). Covers: self-registration of 2 Customers + 1 Agent + 1 Merchant, Admin activation, SYSTEM->Agent deposit, Agent->Customer deposit (commission), Customer->Customer send money (service fee), Customer->Agent withdraw/cash-out (service fee), Customer->Merchant payment. 30 positive + negative test cases with pm.test assertions.\n\nPREREQUISITE (read before running): Agent/Customer logins are OTP-gated (2FA). This collection uses the app's documented '?env=dev' + DEFAULT_OTP bypass (see CLAUDE.md section 5.4) to verify OTP without reading email/console. Your LOCAL .env must have DEFAULT_OTP set (e.g. DEFAULT_OTP=1234) and match the 'defaultOtp' collection variable, and the API server must be restarted after adding it. Never set DEFAULT_OTP outside a local/test environment.\n\nRun order matters - use 'Run collection' (Collection Runner) top-to-bottom, folders in numeric order. Each run auto-generates fresh unique phone numbers/emails via a timestamp so it is safely re-runnable.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5000" },
		{ "key": "partnerKey", "value": "ROADTOSDET" },
		{ "key": "defaultOtp", "value": "1234" },
		{ "key": "sharedPassword", "value": "Test@1234" },
		{ "key": "sharedNid", "value": "1234567890" },
		{ "key": "adminEmail", "value": "admin@dmoney.com" },
		{ "key": "adminPassword", "value": "1234" },
		{ "key": "systemEmail", "value": "system@dmoney.com" },
		{ "key": "systemPassword", "value": "1234" },
		{ "key": "runId", "value": "" },
		{ "key": "customer1Phone", "value": "" },
		{ "key": "customer2Phone", "value": "" },
		{ "key": "agentPhone", "value": "" },
		{ "key": "merchantPhone", "value": "" },
		{ "key": "customer1Email", "value": "" },
		{ "key": "customer2Email", "value": "" },
		{ "key": "agentEmail", "value": "" },
		{ "key": "merchantEmail", "value": "" },
		{ "key": "customer1Id", "value": "" },
		{ "key": "customer2Id", "value": "" },
		{ "key": "agentId", "value": "" },
		{ "key": "merchantId", "value": "" },
		{ "key": "adminToken", "value": "" },
		{ "key": "systemToken", "value": "" },
		{ "key": "agentToken", "value": "" },
		{ "key": "customer1Token", "value": "" },
		{ "key": "customer2Token", "value": "" }
	],
	"item": [
		{
			"name": "00 - Setup",
			"item": [
				{
					"name": "Init Test Data (Health Check + Generate Unique Users)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const ts = Date.now();",
									"function phoneFrom(offset) {",
									"    const n = (ts + offset) % 1000000000;",
									"    return '01' + String(n).padStart(9, '0');",
									"}",
									"pm.collectionVariables.set('runId', String(ts));",
									"pm.collectionVariables.set('customer1Phone', phoneFrom(1));",
									"pm.collectionVariables.set('customer2Phone', phoneFrom(2));",
									"pm.collectionVariables.set('agentPhone', phoneFrom(3));",
									"pm.collectionVariables.set('merchantPhone', phoneFrom(4));",
									"pm.collectionVariables.set('customer1Email', `dmoney.qa.cust1.${ts}@gmail.com`);",
									"pm.collectionVariables.set('customer2Email', `dmoney.qa.cust2.${ts}@gmail.com`);",
									"pm.collectionVariables.set('agentEmail', `dmoney.qa.agent.${ts}@gmail.com`);",
									"pm.collectionVariables.set('merchantEmail', `dmoney.qa.merchant.${ts}@gmail.com`);"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Setup - API is reachable', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"console.log('Generated test identities for run ' + pm.collectionVariables.get('runId'));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
					}
				}
			]
		},
		{
			"name": "01 - Registration",
			"item": [
				{
					"name": "TC01 - Register Customer 1 (Positive)",
					"event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
						"pm.test('TC01 - Status 201 Created', function () { pm.response.to.have.status(201); });",
						"const jsonData = pm.response.json();",
						"pm.test('TC01 - Registration success, status pending, role Customer', function () {",
						"    pm.expect(jsonData.message).to.eql('Registration successful. Your account is pending approval by an admin.');",
						"    pm.expect(jsonData.user.status).to.eql('pending');",
						"    pm.expect(jsonData.user.role).to.eql('Customer');",
						"});",
						"pm.collectionVariables.set('customer1Id', jsonData.user.id);"
					] } }],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n    \"name\": \"QA Customer One\",\n    \"email\": \"{{customer1Email}}\",\n    \"password\": \"{{sharedPassword}}\",\n    \"phone_number\": \"{{customer1Phone}}\",\n    \"nid\": \"{{sharedNid}}\",\n    \"role\": \"Customer\"\n}", "options": { "raw": { "language": "json" } } },
						"url": { "raw": "{{baseUrl}}/user/register", "host": ["{{baseUrl}}"], "path": ["user", "register"] }
					}
				},
